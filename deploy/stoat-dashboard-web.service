[Unit]
Description=Stoatmod dashboard frontend
After=network.target

[Service]
Type=simple
User=stoatmod
WorkingDirectory=/opt/stoatmod-website
EnvironmentFile=/opt/stoatmod-website/.env
# Listen only on this machine; the reverse proxy (see Caddyfile.example) forwards public traffic.
ExecStart=/usr/bin/pnpm start --hostname 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/stoatmod-website/.wrangler

[Install]
WantedBy=multi-user.target
